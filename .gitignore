# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# SQLite databases (keep data/.gitkeep, ignore runtime database files)
*.db
*.sqlite
*.sqlite3
data/*.db
data/*.sqlite
!data/.gitkeep

# Environments
.env
.venv
env/
venv/
ENV/

# IDE & Editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/
